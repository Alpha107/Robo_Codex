    "sram": "1 MB (plus additional tightly-coupled memory)",
    "digitalIOPins": 40,
    "analogInputPins": "up to 14 (shared with some digital pins)",
    "dimensions": "35mm x 18mm",
    "connector": "Micro-USB"
  },
