    "sram": "2.5 KB",
    "eeprom": "1 KB",
    "digitalIOPins": 20,
    "pwmPins": 7,
    "analogInputPins": 12,
    "dimensions": "68.6mm x 53.3mm",
    "connector": "Micro-USB (native USB, no separate USB-serial chip)"
  },
