    "flashMemory": "32 KB (2 KB used by bootloader)",
    "sram": "2 KB",
    "eeprom": "1 KB",
    "digitalIOPins": 14,
    "pwmPins": 6,
    "analogInputPins": 6,
    "dimensions": "33mm x 18mm",
    "connector": "None onboard — programmed via external FTDI/USB-serial adapter"
  },
