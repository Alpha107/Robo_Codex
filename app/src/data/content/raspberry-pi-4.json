    "ram": "1GB / 2GB / 4GB / 8GB LPDDR4 (model-dependent)",
    "storage": "microSD card (OS boot), USB boot supported",
    "connectivity": "Gigabit Ethernet, WiFi 802.11ac, Bluetooth 5.0",
    "usb": "2x USB 3.0, 2x USB 2.0",
    "video": "2x micro-HDMI (dual 4K supported)",
    "gpio": "40-pin header, 3.3V logic",
    "dimensions": "85mm x 56mm",
    "connector": "USB-C power (5V/3A)"
  },
