  "useCases": [
    {
      "title": "Custom protocol bit-banging with PIO",
      "scenario": "Drive WS2812B LEDs or other precisely-timed protocols using the RP2040's PIO state machines instead of the CPU.",
      "pinsInvolved": [
        "GP0"
      ],
      "difficulty": "Advanced"
    },
    {
      "title": "Dual-core sensor + control split",
      "scenario": "Run sensor reading on one core and motor control logic on the other for more deterministic timing.",
      "pinsInvolved": [
        "GP26 (ADC0)",
        "GP16",
        "GP17"
      ],
      "difficulty": "Advanced"
    },
    {
      "title": "USB MIDI or HID device",
      "scenario": "The Pico can enumerate as a custom USB device, similar to the Arduino Leonardo but with far more processing headroom.",
      "pinsInvolved": [
        "GP2",
        "GP3"
      ],
      "difficulty": "Intermediate"
    },
    {
      "title": "Battery-powered data logger",
      "scenario": "Power from a LiPo via VSYS and log sensor data to onboard flash.",
      "pinsInvolved": [
        "VSYS",
        "GND",
        "GP4",
        "GP5"
      ],
      "difficulty": "Intermediate"
    }
  ],
